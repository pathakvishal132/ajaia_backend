DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Supabase (used when DB_URL is set) ---
# Use the SESSION pooler (port 5432) or direct connection: the transaction pooler (6543)
# ignores DB_SCHEMA. JDBC (jdbc:postgresql://...) and postgres:// forms are both accepted.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>
# Postgres schema holding this app's tables (keeps them apart from other apps in the same DB)
DB_SCHEMA=ajaia
# Not used by Django (Supabase API key); safe to omit
DB_KEY=

# --- Or a plain local Postgres (used when DB_URL / DATABASE_URL are not set) ---
DB_NAME=collab_docs
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# https://ajaiafrontend.vercel.app is always allowed; add extra origins here
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://127.0.0.1:4200
